# Copy to .env for local dev — and keep it inside api/, next to this file.
# pydantic-settings resolves ".env" relative to wherever you run python/uvicorn
# from, not relative to config.py, so a .env anywhere else silently won't load.
# Never commit a real .env.

ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000

# Local dev default will match infra/docker-compose.yml once we build it (Stage
# after db/). In prod: the Supabase connection string (Session pooler,
# ap-south-1) with +asyncpg added right after postgresql.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codex_vitae

# Local dev default will match infra/docker-compose.yml. In prod: the Upstash
# Redis URL (rediss://... — note the TLS scheme).
REDIS_URL=redis://localhost:6379/0

GEMINI_API_KEY=
PERSONA_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GUARDRAIL_MODEL=openai/gpt-oss-20b

VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=1024
